{
    "name": "lalalili/laravelshoppingcart",
    "description": "Shopping cart package for Laravel 12/13 with PHP 8.3+ support.",
    "type": "library",
    "keywords": [
        "laravel",
        "shopping cart",
        "cart",
        "ecommerce"
    ],
    "license": "MIT",
    "authors": [
        {
            "name": "James Liang",
            "email": "lalalili@gmail.com"
        }
    ],
    "support": {
        "source": "https://github.com/lalalili/laravelshoppingcart",
        "issues": "https://github.com/lalalili/laravelshoppingcart/issues"
    },
    "require": {
        "php": "^8.3",
        "illuminate/support": "^12.0|^13.0",
        "illuminate/translation": "^12.0|^13.0",
        "illuminate/validation": "^12.0|^13.0"
    },
    "require-dev": {
        "larastan/larastan": "^3.0",
        "laravel/pint": "^1.0",
        "mockery/mockery": "^1.6",
        "orchestra/testbench": "^9.0|^10.0|^11.0",
        "pestphp/pest": "^5.0",
        "pestphp/pest-plugin-phpstan": "^5.0",
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^13.0"
    },
    "autoload": {
        "psr-4": {
            "Lalalili\\ShoppingCart\\": "src/Lalalili/ShoppingCart/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Lalalili\\ShoppingCart\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Lalalili\\ShoppingCart\\ShoppingCartServiceProvider"
            ],
            "aliases": {
                "ShoppingCart": "Lalalili\\ShoppingCart\\Facades\\ShoppingCartFacade"
            }
        }
    },
    "scripts": {
        "test": "pest --compact",
        "test:integration": "pest --compact tests/Integration",
        "test:pest": "pest --colors=always",
        "analyse": "phpstan analyse --configuration=phpstan.neon.dist --no-progress",
        "analyse:max": "phpstan analyse src --level=max --no-progress",
        "format": "pint",
        "bench": "php benchmarks/cart_benchmark.php",
        "coverage:check": "php tools/check_coverage.php build/clover.xml 85"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    }
}
